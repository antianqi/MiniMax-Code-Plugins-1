            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%PLUGIN_ROOT%\\io.minimax.mcode\\hooks\\scripts\\permission-denied.ps1\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
